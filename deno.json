{
  "name": "@roelentless/rig",
  "version": "0.0.0",
  "exports": "./rig.ts",
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1.0.11",
    "@std/cli": "jsr:@std/cli@^1.0.25"
  },
  "tasks": {
    "dev": "deno run -A rig.ts",
    "test": "deno test -A test/",
    "test:darwin": "deno test -A test/darwin.test.ts",
    "test:linux": "docker build -f test/Dockerfile -t rig-test-linux . && docker run --rm rig-test-linux",
    "install": "deno install -A -g -n rig rig.ts",
    "uninstall": "deno uninstall -g rig"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "rig.ts"
    ]
  }
}
