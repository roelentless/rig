{
  "name": "@roelentless/rig",
  "version": "0.0.0",
  "exports": "./rig.ts",
  "tasks": {
    "dev": "deno run -A rig.ts",
    "test": "deno test -A test/rig.test.ts",
    "test:docker": "docker build -f test/Dockerfile -t rig-test-linux . && docker run --rm rig-test-linux",
    "install": "deno install -A -g -n rig rig.ts",
    "uninstall": "deno uninstall -g rig"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "rig.ts",
      "version.ts"
    ]
  }
}
